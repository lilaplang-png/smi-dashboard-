function oasCls(o){if(o==='แดง')return'u-r';if(o==='ส้ม')return'u-o';if(o==='เหลือง')return'u-y';return'u-g';}
function oasLbl(o){if(o==='แดง')return'🔴แดง';if(o==='ส้ม')return'🟠ส้ม';if(o==='เหลือง')return'🟡เหลือง';return'🟢เขียว';}
function txLbl(t){if(t==='k')return'รพ.โกสุม';if(t==='j')return'รพ.จิตเวช';if(t==='d')return'ธัญญา/ร้อยเอ็ด';if(t==='m')return'รพ.มหาสารคาม';if(t==='kj')return'โกสุม+จิตเวช';if(t==='kd')return'โกสุม+ธัญญา';if(t==='r')return'หนี';if(t==='p')return'ปฏิเสธ';return'-';}
function netLbl(n){if(n==='hosp')return'<span class="net-pill nb-h">🏥 สาธารณสุข</span>';if(n==='police')return'<span class="net-pill nb-p">👮 ตำรวจ</span>';if(n==='admin')return'<span class="net-pill nb-a">🏛️ ปกครอง</span>';return'<span class="net-pill nb-l">🏘️ ท้องถิ่น</span>';}
function qd(q){return P.filter(p=>p.q===q);}

const F={family:'Sarabun',size:11};
const TC='#64748b',GC='rgba(0,0,0,.04)';
function bO(s=false){return{responsive:true,maintainAspectRatio:false,plugins:{legend:{labels:{color:'#475569',font:F,padding:8}}},scales:{x:{stacked:s,ticks:{color:TC,font:F},grid:{color:GC}},y:{stacked:s,ticks:{color:TC,font:F},grid:{color:GC}}}};}
function pO(p='right'){return{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:p,labels:{color:'#475569',font:F,padding:7}}}};}
function oasCnt(a){let r=0,o=0,y=0,g=0;a.forEach(p=>{if(p.oas==='แดง')r++;else if(p.oas==='ส้ม')o++;else if(p.oas==='เหลือง')y++;else g++;});return[r,o,y,g];}
function dCnt(a){return[a.filter(p=>p.yaba).length,a.filter(p=>p.sura).length,a.filter(p=>p.ganja).length];}
function nCnt(a){return[a.filter(p=>p.net==='hosp').length,a.filter(p=>p.net==='police').length,a.filter(p=>p.net==='admin').length,a.filter(p=>p.net==='local').length];}
function tCnt(a){return[a.filter(p=>p.tx==='k'||p.tx==='kj'||p.tx==='kd').length,a.filter(p=>p.tx==='j'||p.tx==='kj').length];}

