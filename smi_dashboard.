<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dashboard SMI - อ.โกสุมพิสัย ปีงบ 2569</title>
<link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<style>
:root{
  --bg:#f0f4f8;--white:#fff;--card:#fff;--border:#dde3ed;--border2:#c8d3e3;
  --blue:#2563eb;--blue-pale:#eff6ff;
  --q1:#7c3aed;--q1p:#f5f3ff;--q2:#0369a1;--q2p:#e0f2fe;
  --q3:#047857;--q3p:#ecfdf5;--q4:#b45309;--q4p:#fffbeb;
  --red:#dc2626;--orange:#ea580c;--yellow:#ca8a04;--green:#16a34a;
  --text:#1e293b;--text2:#475569;--text3:#94a3b8;
  --hosp:#0369a1;--hospp:#e0f2fe;
  --pol:#7c3aed;--polp:#f5f3ff;
  --adm:#047857;--admp:#ecfdf5;
  --loc:#b45309;--locp:#fffbeb;
}
*{margin:0;padding:0;box-sizing:border-box;}
body{font-family:'Sarabun',sans-serif;background:var(--bg);color:var(--text);min-height:100vh;}
.header{background:linear-gradient(135deg,#1e3a6e 0%,#1d4ed8 60%,#0369a1 100%);box-shadow:0 4px 20px rgba(30,58,110,.25);position:sticky;top:0;z-index:100;}
.header-inner{max-width:1600px;margin:0 auto;padding:13px 20px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;}
.logo{width:44px;height:44px;background:rgba(255,255,255,.18);border:2px solid rgba(255,255,255,.3);border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0;}
.hd-left{display:flex;align-items:center;gap:12px;}
.hd-t h1{font-size:clamp(12px,2vw,17px);font-weight:800;color:#fff;}
.hd-t p{font-size:11px;color:rgba(255,255,255,.7);margin-top:2px;}
.hd-right{display:flex;align-items:center;gap:7px;flex-wrap:wrap;}
.hbadge{padding:4px 11px;border-radius:20px;font-size:11px;font-weight:600;background:rgba(255,255,255,.15);color:#fff;border:1px solid rgba(255,255,255,.25);}
.hbadge.live{background:rgba(16,185,129,.25);border-color:rgba(16,185,129,.5);color:#6ee7b7;}
.ldot{display:inline-block;width:6px;height:6px;background:#34d399;border-radius:50%;margin-right:4px;animation:blink 2s infinite;}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.4}}
.upload-fab{position:fixed;top:70px;right:16px;z-index:200;background:linear-gradient(135deg,#16a34a,#15803d);color:#fff;border:none;border-radius:12px;padding:10px 16px;font-family:'Sarabun',sans-serif;font-size:13px;font-weight:700;cursor:pointer;box-shadow:0 4px 20px rgba(22,163,74,.5);display:flex;align-items:center;gap:7px;transition:all .2s;}
.upload-fab:hover{transform:translateY(-2px);}
.pulse{width:8px;height:8px;background:#fff;border-radius:50%;animation:blink 1.5s infinite;}
.nav-wrap{background:var(--white);border-bottom:2px solid var(--border);box-shadow:0 2px 8px rgba(0,0,0,.06);overflow-x:auto;scrollbar-width:none;}
.nav-wrap::-webkit-scrollbar{display:none;}
.nav-inner{max-width:1600px;margin:0 auto;padding:0 16px;display:flex;gap:1px;}
.tab-btn{padding:10px 13px;border:none;background:none;color:var(--text2);font-family:'Sarabun',sans-serif;font-size:12px;font-weight:600;cursor:pointer;border-bottom:3px solid transparent;white-space:nowrap;transition:all .2s;}
.tab-btn:hover{color:var(--blue);background:var(--blue-pale);}
.tab-btn.active{color:var(--blue);border-bottom-color:var(--blue);background:var(--blue-pale);}
.tab-btn.tq1.active{color:var(--q1);border-bottom-color:var(--q1);background:var(--q1p);}
.tab-btn.tq2.active{color:var(--q2);border-bottom-color:var(--q2);background:var(--q2p);}
.tab-btn.tq3.active{color:var(--q3);border-bottom-color:var(--q3);background:var(--q3p);}
.tab-btn.tq4.active{color:var(--q4);border-bottom-color:var(--q4);background:var(--q4p);}
.main{max-width:1600px;margin:0 auto;padding:18px;}
.section{display:none;}.section.active{display:block;}
.up-overlay{position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:300;display:none;align-items:center;justify-content:center;}
.up-overlay.open{display:flex;}
.up-modal{background:#fff;border-radius:20px;padding:28px;max-width:460px;width:92%;box-shadow:0 20px 60px rgba(0,0,0,.3);}
.up-modal h2{font-size:17px;font-weight:800;color:var(--text);margin-bottom:4px;}
.drop-zone{border:2px dashed #86efac;background:#f0fdf4;border-radius:14px;padding:28px;text-align:center;cursor:pointer;margin-bottom:14px;}
.drop-zone:hover{border-color:#16a34a;background:#dcfce7;}
.dz-ico{font-size:38px;margin-bottom:7px;}
.dz-txt{font-size:13px;font-weight:700;color:#15803d;margin-bottom:3px;}
.dz-s{font-size:11px;color:var(--text3);}
.up-note{background:#fffbeb;border:1px solid #fcd34d;border-radius:10px;padding:11px 13px;font-size:11px;color:#92400e;line-height:1.7;margin-bottom:12px;}
.up-note strong{display:block;font-size:12px;margin-bottom:3px;color:#b45309;}
.btn-c{width:100%;padding:9px;background:#f1f5f9;color:var(--text2);border:none;border-radius:10px;font-family:'Sarabun',sans-serif;font-size:13px;cursor:pointer;font-weight:600;}
.qr-fab{position:fixed;bottom:20px;right:16px;z-index:200;background:var(--blue);color:#fff;border:none;border-radius:50px;padding:11px 18px;font-family:'Sarabun',sans-serif;font-size:13px;font-weight:700;cursor:pointer;box-shadow:0 4px 20px rgba(37,99,235,.4);display:flex;align-items:center;gap:7px;transition:transform .2s;}
.qr-fab:hover{transform:translateY(-2px);}
.qr-overlay{position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:300;display:none;align-items:center;justify-content:center;}
.qr-overlay.open{display:flex;}
.qr-modal{background:#fff;border-radius:20px;padding:24px;max-width:450px;width:92%;box-shadow:0 20px 60px rgba(0,0,0,.3);}
.qr-modal h2{font-size:15px;font-weight:800;margin-bottom:3px;}
.qr-sub{font-size:11px;color:var(--text2);margin-bottom:14px;}
.qr-box{display:flex;justify-content:center;margin-bottom:14px;}
.link-row{display:flex;gap:7px;margin-bottom:12px;}
.link-inp{flex:1;border:1.5px solid var(--border2);border-radius:8px;padding:6px 10px;font-family:'Sarabun',sans-serif;font-size:11px;color:var(--text);background:#f8fafc;outline:none;}
.copy-btn{background:var(--blue);color:#fff;border:none;border-radius:8px;padding:6px 12px;font-family:'Sarabun',sans-serif;font-size:12px;font-weight:600;cursor:pointer;}
.msg-tabs{display:flex;gap:5px;margin-bottom:8px;flex-wrap:wrap;}
.msg-tab{padding:5px 10px;border-radius:8px;font-size:11px;font-weight:600;cursor:pointer;border:1.5px solid var(--border2);background:#f8fafc;color:var(--text2);}
.msg-tab.active{background:var(--blue-pale);color:var(--blue);border-color:var(--blue);}
.msg-box{background:#f8fafc;border:1px solid var(--border);border-radius:10px;padding:10px;font-size:11px;color:var(--text2);line-height:1.7;margin-bottom:8px;white-space:pre-wrap;max-height:130px;overflow:auto;}
.msg-copy-btn{width:100%;padding:7px;background:var(--green);color:#fff;border:none;border-radius:9px;font-family:'Sarabun',sans-serif;font-size:12px;font-weight:700;cursor:pointer;margin-bottom:7px;}
.alert-bar{display:flex;gap:11px;align-items:flex-start;background:#fff5f5;border:1px solid #fecaca;border-left:4px solid var(--red);border-radius:12px;padding:12px 15px;margin-bottom:16px;}
.alert-bar strong{display:block;font-size:13px;font-weight:700;color:var(--red);margin-bottom:2px;}
.alert-bar p{font-size:11px;color:var(--text2);line-height:1.6;}
.alert-bar b{color:var(--red);}
.new-badge{display:inline-block;background:#dcfce7;color:#15803d;border:1px solid #86efac;border-radius:20px;padding:1px 7px;font-size:10px;font-weight:700;margin-left:5px;}
.q-banner{display:flex;align-items:center;gap:12px;border-radius:13px;padding:13px 16px;margin-bottom:16px;border-left:5px solid;}
.q-banner.q1{background:var(--q1p);border-color:var(--q1);}
.q-banner.q2{background:var(--q2p);border-color:var(--q2);}
.q-banner.q3{background:var(--q3p);border-color:var(--q3);}
.q-banner.q4{background:var(--q4p);border-color:var(--q4);}
.q-banner-text h2{font-size:14px;font-weight:800;}
.q1 .q-banner-text h2{color:var(--q1);}
.q2 .q-banner-text h2{color:var(--q2);}
.q3 .q-banner-text h2{color:var(--q3);}
.q4 .q-banner-text h2{color:var(--q4);}
.q-banner-text p{font-size:11px;margin-top:2px;opacity:.7;}
.q-chips{margin-left:auto;display:flex;gap:6px;flex-wrap:wrap;}
.q-chip{padding:4px 11px;border-radius:20px;font-size:11px;font-weight:700;background:#fff;border:2px solid;}
.q1 .q-chip{border-color:var(--q1);color:var(--q1);}
.q2 .q-chip{border-color:var(--q2);color:var(--q2);}
.q3 .q-chip{border-color:var(--q3);color:var(--q3);}
.q4 .q-chip{border-color:var(--q4);color:var(--q4);}
.kpi-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(135px,1fr));gap:10px;margin-bottom:16px;}
.kpi-card{background:var(--card);border:1px solid var(--border);border-radius:13px;padding:13px;box-shadow:0 1px 4px rgba(0,0,0,.05);position:relative;overflow:hidden;}
.kpi-card::after{content:'';position:absolute;top:0;left:0;right:0;height:4px;background:var(--kpi-top,var(--blue));border-radius:13px 13px 0 0;}
.kpi-icon{font-size:20px;margin-bottom:5px;display:block;}
.kpi-val{font-size:clamp(22px,3vw,32px);font-weight:800;color:var(--text);line-height:1;}
.kpi-lbl{font-size:11px;color:var(--text2);margin:4px 0 7px;font-weight:500;line-height:1.4;}
.kpi-sub{font-size:10px;color:var(--text3);padding-top:5px;border-top:1px solid var(--border);}
.kpi-sub b{color:var(--blue);}
.net-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:11px;margin-bottom:16px;}
.net-card{background:var(--card);border:1px solid var(--border);border-radius:13px;padding:14px;border-top:4px solid;box-shadow:0 1px 4px rgba(0,0,0,.05);}
.net-card.h{border-top-color:var(--hosp);}
.net-card.p{border-top-color:var(--pol);}
.net-card.a{border-top-color:var(--adm);}
.net-card.l{border-top-color:var(--loc);}
.net-num{font-size:32px;font-weight:800;line-height:1;}
.h .net-num{color:var(--hosp);}.p .net-num{color:var(--pol);}.a .net-num{color:var(--adm);}.l .net-num{color:var(--loc);}
.net-lbl{font-size:12px;font-weight:700;color:var(--text);margin:4px 0 5px;}
.net-sub{font-size:10px;color:var(--text3);border-top:1px solid var(--border);padding-top:5px;}
.charts-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(270px,1fr));gap:13px;margin-bottom:16px;}
.chart-card{background:var(--card);border:1px solid var(--border);border-radius:13px;padding:14px;box-shadow:0 1px 4px rgba(0,0,0,.04);}
.chart-card.wide{grid-column:1/-1;}
.chart-hdr{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:10px;}
.chart-title{font-size:13px;font-weight:700;color:var(--text);}
.chart-sub{font-size:10px;color:var(--text3);margin-top:1px;}
.chart-wrap{position:relative;height:185px;}
.chart-wrap.tall{height:250px;}
.sec-title{font-size:14px;font-weight:800;color:var(--text);margin-bottom:12px;padding-bottom:8px;border-bottom:2px solid var(--border);display:flex;align-items:center;gap:7px;}
.table-card{background:var(--card);border:1px solid var(--border);border-radius:13px;overflow:hidden;box-shadow:0 1px 4px rgba(0,0,0,.04);margin-bottom:16px;}
.table-hdr{padding:11px 14px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:7px;background:#f8fafc;}
.table-title{font-size:13px;font-weight:700;color:var(--text);}
.search-box{background:var(--white);border:1.5px solid var(--border2);border-radius:8px;padding:5px 11px;color:var(--text);font-family:'Sarabun',sans-serif;font-size:12px;outline:none;min-width:150px;}
.search-box:focus{border-color:var(--blue);}
select.fsel{background:var(--white);border:1.5px solid var(--border2);border-radius:8px;padding:5px 8px;font-family:'Sarabun',sans-serif;font-size:11px;color:var(--text);outline:none;cursor:pointer;}
.table-wrap{overflow-x:auto;}
table{width:100%;border-collapse:collapse;font-size:11px;}
thead tr{background:#f8fafc;}
thead th{padding:7px 8px;text-align:left;font-weight:700;color:var(--text2);font-size:10px;text-transform:uppercase;letter-spacing:.3px;white-space:nowrap;border-bottom:2px solid var(--border2);}
tbody tr{border-bottom:1px solid var(--border);transition:background .1s;}
tbody tr:hover{background:var(--blue-pale);}
tbody tr.nr{background:#f0fdf4;}
tbody td{padding:6px 8px;color:var(--text);vertical-align:middle;}
.nb{background:#f1f5f9;border-radius:5px;padding:1px 5px;font-weight:700;font-size:10px;color:var(--text2);}
.gm{background:#dbeafe;color:#1d4ed8;padding:2px 7px;border-radius:20px;font-size:10px;font-weight:700;}
.gf{background:#fce7f3;color:#be185d;padding:2px 7px;border-radius:20px;font-size:10px;font-weight:700;}
.u-pill{display:inline-flex;align-items:center;padding:2px 7px;border-radius:20px;font-size:10px;font-weight:700;white-space:nowrap;border:1px solid;}
.u-r{background:#fef2f2;color:#dc2626;border-color:#fca5a5;}
.u-o{background:#fff7ed;color:#c2410c;border-color:#fdba74;}
.u-y{background:#fefce8;color:#a16207;border-color:#fde047;}
.u-g{background:#f0fdf4;color:#15803d;border-color:#86efac;}
.qt{display:inline-block;padding:1px 6px;border-radius:5px;font-size:10px;font-weight:700;}
.Q1{background:#ede9fe;color:#6d28d9;}.Q2{background:#e0f2fe;color:#0369a1;}
.Q3{background:#dcfce7;color:#15803d;}.Q4{background:#fffbeb;color:#b45309;}
.net-pill{display:inline-flex;align-items:center;gap:3px;padding:2px 7px;border-radius:20px;font-size:10px;font-weight:700;border:1px solid;}
.nb-h{background:var(--hospp);color:var(--hosp);border-color:#7dd3fc;}
.nb-p{background:var(--polp);color:var(--pol);border-color:#c4b5fd;}
.nb-a{background:var(--admp);color:var(--adm);border-color:#6ee7b7;}
.nb-l{background:var(--locp);color:var(--loc);border-color:#fcd34d;}
.dot{display:inline-block;width:7px;height:7px;border-radius:50%;}
.dy{background:#10b981;}.dn{background:#e2e8f0;border:1px solid #cbd5e1;}
.pagination{display:flex;align-items:center;justify-content:space-between;padding:9px 14px;border-top:1px solid var(--border);background:#f8fafc;flex-wrap:wrap;gap:6px;}
.page-info{font-size:11px;color:var(--text3);}
.page-btns{display:flex;gap:3px;flex-wrap:wrap;}
.page-btn{background:var(--white);border:1.5px solid var(--border2);color:var(--text2);width:26px;height:26px;border-radius:6px;cursor:pointer;font-size:11px;display:flex;align-items:center;justify-content:center;transition:all .15s;font-family:'Sarabun',sans-serif;font-weight:600;}
.page-btn:hover{background:var(--blue-pale);border-color:var(--blue);color:var(--blue);}
.page-btn.active{background:var(--blue);border-color:var(--blue);color:#fff;}
.cmp-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:11px;margin-bottom:16px;}
.cmp-card{background:var(--card);border:1px solid var(--border);border-radius:13px;overflow:hidden;}
.cmp-hdr{padding:9px 13px;font-weight:800;font-size:12px;display:flex;align-items:center;justify-content:space-between;}
.q1h{background:var(--q1p);color:var(--q1);border-bottom:2px solid #c4b5fd;}
.q2h{background:var(--q2p);color:var(--q2);border-bottom:2px solid #7dd3fc;}
.q3h{background:var(--q3p);color:var(--q3);border-bottom:2px solid #6ee7b7;}
.q4h{background:var(--q4p);color:var(--q4);border-bottom:2px solid #fcd34d;}
.cmp-num{font-size:20px;font-weight:800;}
.cmp-row{display:flex;justify-content:space-between;padding:6px 13px;border-bottom:1px solid var(--border);font-size:11px;}
.cmp-row:last-child{border-bottom:none;}
.cmp-row span:first-child{color:var(--text2);}
.cmp-row span:last-child{font-weight:700;}
.area-card{background:var(--card);border:1px solid var(--border);border-radius:13px;overflow:hidden;}
.area-item{display:flex;align-items:center;padding:7px 12px;border-bottom:1px solid var(--border);gap:7px;}
.area-item:last-child{border-bottom:none;}
.area-item:hover{background:var(--blue-pale);}
.rnk{width:20px;height:20px;border-radius:5px;background:#f1f5f9;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;color:var(--text3);flex-shrink:0;}
.rnk.g{background:#fef3c7;color:#b45309;}.rnk.s{background:#f1f5f9;color:#475569;}.rnk.b{background:#ffedd5;color:#9a3412;}
.area-name{flex:1;font-size:12px;font-weight:500;}
.bw{width:75px;height:4px;background:#f1f5f9;border-radius:2px;overflow:hidden;}
.bf{height:100%;border-radius:2px;background:#3b82f6;}
.area-cnt{font-size:14px;font-weight:800;color:var(--text);min-width:22px;text-align:right;}
.imc-badge{display:inline-block;background:#fef3c7;color:#b45309;border:1px solid #fcd34d;border-radius:4px;padding:1px 5px;font-size:9px;font-weight:700;}
.footer{text-align:center;padding:13px;color:var(--text3);font-size:10px;border-top:1px solid var(--border);margin-top:10px;background:var(--white);}
@media(max-width:768px){.main{padding:10px;}.charts-grid{grid-template-columns:1fr;}.kpi-grid{grid-template-columns:repeat(2,1fr);}.q-chips{display:none;}.upload-fab{top:auto;bottom:70px;}}
@media(max-width:480px){.kpi-grid{grid-template-columns:1fr 1fr;}.main{padding:8px;}}
::-webkit-scrollbar{width:4px;height:4px;}::-webkit-scrollbar-track{background:#f1f5f9;}::-webkit-scrollbar-thumb{background:var(--border2);border-radius:2px;}
</style>
</head>
<body>

<div class="header">
  <div class="header-inner">
    <div class="hd-left">
      <div class="logo">🧠</div>
      <div class="hd-t">
        <h1>ระบบติดตาม SMI อำเภอโกสุมพิสัย จ.มหาสารคาม</h1>
        <p>ผู้ป่วยจิตเวชที่มีความรุนแรง • ปีงบ 2569 (1 ต.ค. 68 – 30 ก.ย. 69) • ข้อมูล ณ 13 ส.ค. 2569</p>
      </div>
    </div>
    <div class="hd-right">
      <div class="hbadge live"><span class="ldot"></span>อัปเดต 13 ส.ค. 69</div>
      <div class="hbadge">📊 130 ราย</div>
    </div>
  </div>
</div>

<button class="upload-fab" onclick="document.getElementById('upOverlay').classList.add('open')">
  <span class="pulse"></span> 📂 อัปโหลดข้อมูลใหม่
</button>

<div class="nav-wrap">
  <div class="nav-inner">
    <button class="tab-btn active" onclick="sw('overview',this)">📊 ภาพรวม</button>
    <button class="tab-btn" onclick="sw('network',this)">🌐 เครือข่าย</button>
    <button class="tab-btn tq1" onclick="sw('q1',this)">🟣 Q1 (18)</button>
    <button class="tab-btn tq2" onclick="sw('q2',this)">🔵 Q2 (53)</button>
    <button class="tab-btn tq3" onclick="sw('q3',this)">🟢 Q3 (37)</button>
    <button class="tab-btn tq4" onclick="sw('q4',this)">🟡 Q4 (22)</button>
    <button class="tab-btn" onclick="sw('compare',this)">📐 เปรียบเทียบ</button>
    <button class="tab-btn" onclick="sw('patients',this)">👥 รายชื่อ (130)</button>
    <button class="tab-btn" onclick="sw('area',this)">📍 พื้นที่</button>
  </div>
</div>

<div class="main">

<!-- OVERVIEW -->
<div class="section active" id="section-overview">
  <div class="alert-bar">
