}
function gp(n){pg=n;renderT();}
function af(){
  const q=document.getElementById('sI').value.toLowerCase();
  const qf=document.getElementById('qF').value;
  const oasf=document.getElementById('oasF').value;
  const nf=document.getElementById('netF').value;
  fd=P.filter(p=>
    (qf==='all'||p.q===qf)&&
    (oasf==='all'||p.oas===oasf)&&
    (nf==='all'||p.net===nf)&&
    (p.name.toLowerCase().includes(q)||p.hn.includes(q)||p.sub.includes(q)||p.note.toLowerCase().includes(q))
  );pg=1;renderT();
}
